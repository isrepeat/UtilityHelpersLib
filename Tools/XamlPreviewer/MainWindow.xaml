<Window x:Class="XamlPreviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:XamlPreviewer"
        xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
        Title="MobileClock XAML Previewer"
        Width="1500"
        Height="950"
        MinWidth="1000"
        MinHeight="650"
        Background="#181818">
    <!--
        Декларативная оболочка превьювера: общие тёмные стили, панели редакторов,
        управление масштабом и устройством, а также область визуального превью.
        Состояние, загрузка файлов и обработчики событий находятся в MainWindow.xaml.cs.
    -->
    <Window.Resources>
        <!-- Общие ресурсы темы используются и стандартными WPF-контролами, и AvalonEdit. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                         Color="#242424" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"
                         Color="#303030" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}"
                         Color="#3A3A3A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"
                         Color="#535353" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}"
                         Color="#747474" />
        <SolidColorBrush x:Key="ControlBackgroundBrush"
                         Color="#252525" />
        <SolidColorBrush x:Key="ControlBorderBrush"
                         Color="#4A4A4A" />
        <SolidColorBrush x:Key="ControlForegroundBrush"
                         Color="#E6E6E6" />
        <Style TargetType="TextBox">
            <Setter Property="Padding"
                    Value="6 3" />
            <Setter Property="Background"
                    Value="#202020" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="CaretBrush"
                    Value="#F0D78C" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background"
                    Value="#252525" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="Foreground"
                    Value="#E6E6E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchPanelButtonStyle"
               TargetType="Button">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="#303030" />
            <Setter Property="BorderBrush"
                    Value="#555555" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchPanelToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding"
                    Value="9 3" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Background"
                    Value="#303030" />
            <Setter Property="BorderBrush"
                    Value="#555555" />
            <Setter Property="Foreground"
                    Value="#E6E6E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="search:SearchPanel">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="search:SearchPanel">
                        <Border Background="#252525"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Arrow">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PART_searchTextBox"
                                         Width="525"
                                         Height="36"
                                         Margin="0 0 6 0"
                                         FontSize="16"
                                         VerticalContentAlignment="Center">
                                    <TextBox.Text>
                                        <Binding Path="SearchPattern"
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <ExceptionValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <Button Width="36"
                                        Height="36"
                                        Margin="0 0 6 0"
                                        Style="{StaticResource SearchPanelButtonStyle}"
                                        Command="search:SearchCommands.FindNext"
                                        ToolTip="Следующее совпадение (F3)">
                                    <local:SvgIconControl Source="Resources/Icons/find-next.svg"
                                                          Width="18"
                                                          Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Stroke="#E6E6E6"
                                                          StrokeThickness="2.25" />
                                </Button>
                                <Button Width="36"
                                        Height="36"
                                        Margin="0 0 6 0"
                                        Style="{StaticResource SearchPanelButtonStyle}"
                                        Command="search:SearchCommands.FindPrevious"
                                        ToolTip="Предыдущее совпадение (Shift+F3)">
                                    <local:SvgIconControl Source="Resources/Icons/find-previous.svg"
                                                          Width="18"
                                                          Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Stroke="#E6E6E6"
                                                          StrokeThickness="2.25" />
                                </Button>
                                <Button Width="36"
                                        Height="36"
                                        Margin="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SearchPanelButtonStyle}"
                                        Command="search:SearchCommands.CloseSearchPanel"
                                        Focusable="False">
                                    <local:SvgIconControl Source="Resources/Icons/close.svg"
                                                          Width="18"
                                                          Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Stroke="#E6E6E6"
                                                          StrokeThickness="2.25" />
                                </Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Margin="0 6 0 0"
                                            Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource SearchPanelToggleButtonStyle}"
                                                  ToolTip="Учитывать регистр"
                                                  Content="Aa"
                                                  IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ToggleButton Margin="4 0 0 0"
                                                  Style="{StaticResource SearchPanelToggleButtonStyle}"
                                                  ToolTip="Только целые слова"
                                                  Content="ab"
                                                  IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ToggleButton Margin="4 0 0 0"
                                                  Style="{StaticResource SearchPanelToggleButtonStyle}"
                                                  ToolTip="Регулярное выражение"
                                                  Content=".*"
                                                  IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#383838" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#707070" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4A4A4A" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#9D8D4D" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorModeToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#383838" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#707070" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#9D8D4D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSwitchToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="#181818" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#303030" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#707070" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding"
                    Value="6 3" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ToggleButton x:Name="DropDownToggleButton"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleBorder"
                                                        Background="{TemplateBinding Background}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="ToggleBorder"
                                                                Property="Background"
                                                                Value="#303030" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked"
                                                             Value="True">
                                                        <Setter TargetName="ToggleBorder"
                                                                Property="Background"
                                                                Value="#333333" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />
                                    <Path Width="10"
                                          Height="6"
                                          Margin="0 0 8 0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 10 0 L 5 6 Z"
                                          Fill="#B8B8B8"
                                          IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Border}"
                                        Margin="0 2 0 0"
                                        Background="#252525"
                                        BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer MaxHeight="300"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="8 5" />
            <Setter Property="Background"
                    Value="#252525" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type avalonedit:TextEditor}">
            <Setter Property="Background"
                    Value="#1E1E1E" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="LineNumbersForeground"
                    Value="#858585" />
        </Style>
        <Style x:Key="ScrollBarButton"
               TargetType="RepeatButton">
            <Setter Property="Background"
                    Value="#2B2B2B" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3A3A" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#747474" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumbVertical"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="1 0"
                                Background="#5E5E5E"
                                BorderBrush="#777777"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#8A8A8A" />
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#D5BD7D" />
                                <Setter TargetName="ThumbBorder"
                                        Property="BorderBrush"
                                        Value="#F0D78C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumbHorizontal"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="0 1"
                                Background="#5E5E5E"
                                BorderBrush="#777777"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#8A8A8A" />
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#D5BD7D" />
                                <Setter TargetName="ThumbBorder"
                                        Property="BorderBrush"
                                        Value="#F0D78C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarPageButton"
               TargetType="RepeatButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="IsTabStop"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate"
                         TargetType="ScrollBar">
            <Grid SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                    <RowDefinition Height="0.00001*" />
                    <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1"
                        Background="#242424"
                        BorderBrush="#4A4A4A"
                        BorderThickness="1 0" />
                <RepeatButton Grid.Row="0"
                              Command="{x:Static ScrollBar.LineUpCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Data="M 0,4 L 3.5,0.5 L 7,4 L 7,6 L 3.5,2.5 L 0,6 z"
                          Fill="#B8B8B8"
                          Margin="3 4 3 3"
                          Stretch="Uniform" />
                </RepeatButton>
                <Track x:Name="PART_Track"
                       Grid.Row="1"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbVertical}" />
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Row="2"
                              Command="{x:Static ScrollBar.LineDownCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Data="M 0,0.5 L 3.5,4 L 7,0.5 L 7,2.5 L 3.5,6 L 0,2.5 z"
                          Fill="#B8B8B8"
                          Margin="3 3 3 4"
                          Stretch="Uniform" />
                </RepeatButton>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                         TargetType="ScrollBar">
            <Grid SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                    <ColumnDefinition Width="0.00001*" />
                    <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        Background="#242424"
                        BorderBrush="#4A4A4A"
                        BorderThickness="0 1" />
                <RepeatButton Grid.Column="0"
                              Command="{x:Static ScrollBar.LineLeftCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Data="M 4,0 L 0.5,3.5 L 4,7 L 6,7 L 2.5,3.5 L 6,0 z"
                          Fill="#B8B8B8"
                          Margin="4 3 3 3"
                          Stretch="Uniform" />
                </RepeatButton>
                <Track x:Name="PART_Track"
                       Grid.Column="1"
                       IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbHorizontal}" />
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Column="2"
                              Command="{x:Static ScrollBar.LineRightCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Data="M 0,0 L 3.5,3.5 L 0,7 L 2,7 L 5.5,3.5 L 2,0 z"
                          Fill="#B8B8B8"
                          Margin="3 3 4 3"
                          Stretch="Uniform" />
                </RepeatButton>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background"
                    Value="#242424" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="Foreground"
                    Value="#B8B8B8" />
            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Vertical">
                    <Setter Property="Template"
                            Value="{StaticResource VerticalScrollBarTemplate}" />
                </Trigger>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Template"
                            Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
    </Window.Resources>
    <!-- Верхняя панель управляет режимом и текущими файлами; ниже располагаются редактор и превью. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel
                   Margin="10">
            <ToggleButton x:Name="EditorModeToggle"
                          Style="{StaticResource EditorSwitchToggleButtonStyle}"
                          Width="155"
                          Margin="0 0 8 0"
                          Click="EditorModeToggleClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="XamlModeText"
                               Text="XAML" />
                    <TextBlock Margin="8 0"
                               Foreground="#777777"
                               Text="/" />
                    <TextBlock x:Name="ScenariosModeText"
                               Text="Сценарии" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="SettingsButton"
                          Style="{StaticResource EditorModeToggleButtonStyle}"
                          Width="100"
                          Margin="0 0 8 0"
                          Click="SettingsButtonClick"
                          Content="Настройки" />
            <Button x:Name="OpenButton"
                    Width="90"
                    Margin="0 0 8 0"
                    Click="OpenButtonClick"
                    Content="Открыть" />
            <Button x:Name="SaveButton"
                    Width="90"
                    Margin="0 0 16 0"
                    Click="SaveButtonClick"
                    Content="Сохранить" />
            <Button Width="30"
                    Click="EditorZoomOutButtonClick"
                    Content="−" />
            <TextBlock x:Name="EditorZoomText"
                       Width="54"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <Button Width="30"
                    Margin="0 0 16 0"
                    Click="EditorZoomInButtonClick"
                    Content="+" />
            <TextBlock Margin="0 0 8 0"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       Text="Страница:" />
            <ComboBox x:Name="PagePicker"
                      Width="180"
                      Margin="0 0 16 0"
                      SelectionChanged="PagePickerSelectionChanged" />
            <TextBlock Margin="0 0 8 0"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       Text="Сценарий:" />
            <ComboBox x:Name="ScenarioPicker"
                      Width="190"
                      SelectionChanged="ScenarioPickerSelectionChanged" />
            <TextBlock x:Name="FilePathText"
                       Margin="16 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="#999999"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn"
                                  Width="1.15*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <avalonedit:TextEditor x:Name="MarkupEditor"
                                   Margin="10"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="14"
                                   HorizontalScrollBarVisibility="Auto"
                                   ShowLineNumbers="True"
                                   TextChanged="EditorTextChanged"
                                   PreviewKeyDown="MarkupEditorPreviewKeyDown"
                                   VerticalScrollBarVisibility="Auto" />
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#444444"
                          DragCompleted="EditorSplitterDragCompleted" />
            <Grid Grid.Column="2"
                  Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0 0 0 8"
                           VerticalAlignment="Center">
                    <Button Width="30"
                            Click="ZoomOutButtonClick"
                            Content="−" />
                    <TextBlock x:Name="ZoomText"
                               Width="54"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Button Width="30"
                            Margin="0 0 8 0"
                            Click="ZoomInButtonClick"
                            Content="+" />
                    <Button Width="80"
                            Margin="0 0 16 0"
                            Click="FitPreviewButtonClick"
                            Content="Вписать" />
                    <TextBlock Margin="0 0 6 0"
                               VerticalAlignment="Center"
                               Text="Экран:" />
                    <ComboBox x:Name="DevicePresetPicker"
                              Width="175"
                              Margin="0 0 16 0"
                              SelectionChanged="DevicePresetPickerSelectionChanged" />
                    <ToggleButton x:Name="PreviewOrientationToggle"
                                  Style="{StaticResource EditorSwitchToggleButtonStyle}"
                                  Width="190"
                                  Click="PreviewOrientationToggleClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PortraitOrientationText"
                                       Text="Портрет" />
                            <TextBlock Margin="8 0"
                                       Foreground="#777777"
                                       Text="/" />
                            <TextBlock x:Name="LandscapeOrientationText"
                                       Text="Альбомная" />
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>
                <Border Grid.Row="1"
                        Background="#101010"
                        BorderBrush="#555555"
                        BorderThickness="1">
                    <ScrollViewer x:Name="PreviewViewport"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Viewbox x:Name="PreviewViewbox"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Stretch="Uniform">
                            <Border x:Name="DeviceSurface"
                                    ClipToBounds="True" />
                        </Viewbox>
                    </ScrollViewer>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          Background="#444444" />
            <Grid x:Name="ScenarioPanel"
                  Grid.Column="0"
                  Margin="10"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0 0 0 8"
                           Foreground="#DDDDDD"
                           Text="Тестовые данные (JSON)" />
                <avalonedit:TextEditor x:Name="ScenarioEditor"
                                       Grid.Row="1"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="14"
                                       HorizontalScrollBarVisibility="Auto"
                                       ShowLineNumbers="True"
                                       TextChanged="EditorTextChanged"
                                       VerticalScrollBarVisibility="Auto" />
            </Grid>
            <Grid x:Name="SettingsPanel"
                  Grid.Column="0"
                  Margin="10"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0 0 0 8"
                           Foreground="#DDDDDD"
                           Text="Настройки previewer (JSON)" />
                <avalonedit:TextEditor x:Name="SettingsEditor"
                                       Grid.Row="1"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="14"
                                       HorizontalScrollBarVisibility="Auto"
                                       ShowLineNumbers="True"
                                       TextChanged="EditorTextChanged"
                                       VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Padding="10 6"
                   Background="#252525"
                   Foreground="#8FD18B"
                   Text="Готово" />
    </Grid>
</Window>