<Window x:Class="XamlPreviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobileClock XAML Previewer"
        Width="1500"
        Height="950"
        MinWidth="1000"
        MinHeight="650"
        Background="#181818">
    <Window.Resources>
        <SolidColorBrush x:Key="ControlBackgroundBrush"
                         Color="#252525" />
        <SolidColorBrush x:Key="ControlBorderBrush"
                         Color="#4A4A4A" />
        <SolidColorBrush x:Key="ControlForegroundBrush"
                         Color="#E6E6E6" />
        <Style TargetType="Button">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding"
                    Value="6 3" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="#1E1E1E" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="CaretBrush"
                    Value="#F0D78C" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="SelectionBrush"
                    Value="#5A4D26" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="10">
            <Button x:Name="OpenButton"
                    Width="90"
                    Margin="0 0 8 0"
                    Click="OpenButtonClick"
                    Content="Открыть" />
            <Button x:Name="SaveButton"
                    Width="90"
                    Margin="0 0 16 0"
                    Click="SaveButtonClick"
                    Content="Сохранить" />
            <TextBlock Margin="0 0 8 0"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       Text="Сценарий:" />
            <ComboBox x:Name="ScenarioPicker"
                      Width="190"
                      SelectionChanged="ScenarioPickerSelectionChanged" />
            <TextBlock x:Name="FilePathText"
                       Margin="16 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="#999999"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MarkupEditor"
                     Margin="10"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="14"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="EditorTextChanged"
                     VerticalScrollBarVisibility="Auto" />
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#444444" />
            <Border Grid.Column="2"
                    Margin="10"
                    Background="#101010"
                    BorderBrush="#555555"
                    BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Viewbox Width="540"
                             Height="960"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Stretch="Uniform">
                        <Border x:Name="DeviceSurface"
                                Width="720"
                                Height="1280"
                                ClipToBounds="True" />
                    </Viewbox>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="3"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          Background="#444444" />
            <Grid Grid.Column="4"
                  Margin="10"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0 0 0 8"
                           Foreground="#DDDDDD"
                           Text="Тестовые данные (JSON)" />
                <TextBox x:Name="ScenarioEditor"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="14"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="EditorTextChanged"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Padding="10 6"
                   Background="#252525"
                   Foreground="#8FD18B"
                   Text="Готово" />
    </Grid>
</Window>