<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NativeBridgeOutputDir>$(MSBuildProjectDirectory)\..\..\!VS_TMP\Build\$(Configuration)\x64\XamlRuntime.NativeBridge\</NativeBridgeOutputDir>
    <NativeBridgeIntermediateDir>$(MSBuildProjectDirectory)\..\..\!VS_TMP\Intermediate\$(Configuration)\x64\XamlRuntime.NativeBridge.Previewer\</NativeBridgeIntermediateDir>
    <NativeAngleZlibName>z.dll</NativeAngleZlibName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <!-- NativeBridge — отдельный C++ проект; его NuGet restore-cache не является
         частью дерева исходников WPF-приложения. -->
    <None Remove="NativeBridge\obj\**" />
    <ProjectReference Include="NativeBridge\XamlRuntime.NativeBridge.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=x64</SetPlatform>
      <AdditionalProperties>Configuration=$(Configuration);Platform=x64;PreviewerNativeBridgeOutputDir=$(NativeBridgeOutputDir);PreviewerNativeBridgeIntermediateDir=$(NativeBridgeIntermediateDir)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\close.svg" />
    <Resource Include="Resources\Icons\find-next.svg" />
    <Resource Include="Resources\Icons\find-previous.svg" />
    <Resource Include="Resources\Icons\navigate-back.svg" />
    <Resource Include="Resources\Icons\navigate-forward.svg" />
  </ItemGroup>

  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeBridgeOutputDir)XamlRuntime.NativeBridge.dll')" Text="XamlRuntime.NativeBridge.dll was not built: $(NativeBridgeOutputDir)XamlRuntime.NativeBridge.dll" />
    <Copy SourceFiles="$(NativeBridgeOutputDir)XamlRuntime.NativeBridge.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="$(NativeBridgeOutputDir)XamlRuntime.NativeBridge.pdb" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(NativeBridgeOutputDir)XamlRuntime.NativeBridge.pdb')" />
    <Copy SourceFiles="$(NativeBridgeOutputDir)libEGL.dll;$(NativeBridgeOutputDir)libGLESv2.dll;$(NativeBridgeOutputDir)$(NativeAngleZlibName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>