<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>XamlPreviewer</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NativeBridgeOutputDir>$(MSBuildProjectDirectory)\..\..\..\!VS_TMP\Build\$(Configuration)\x64\XamlPreviewer.NativeBridge\</NativeBridgeOutputDir>
    <NativeBridgeIntermediateDir>$(MSBuildProjectDirectory)\..\..\..\!VS_TMP\Intermediate\$(Configuration)\x64\XamlPreviewer.NativeBridge\</NativeBridgeIntermediateDir>
    <NativeAngleZlibName>z.dll</NativeAngleZlibName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <!-- NativeBridge — отдельный C++ проект; его NuGet restore-cache не является
         частью дерева исходников WPF-приложения. -->
    <ProjectReference Include="..\XamlPreviewer.NativeBridge\XamlPreviewer.NativeBridge.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=x64</SetPlatform>
      <AdditionalProperties>Configuration=$(Configuration);Platform=x64;PreviewerNativeBridgeOutputDir=$(NativeBridgeOutputDir);PreviewerNativeBridgeIntermediateDir=$(NativeBridgeIntermediateDir)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\close.svg" />
    <Resource Include="Resources\Icons\expand-all.svg" />
    <Resource Include="Resources\Icons\find-next.svg" />
    <Resource Include="Resources\Icons\find-previous.svg" />
    <Resource Include="Resources\Icons\navigate-back.svg" />
    <Resource Include="Resources\Icons\navigate-forward.svg" />
    <Content Include="Resources\Cursors\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Кэш WPF может сохраниться после удаления сгенерированных исходников.
       В этом случае повторяем генерацию, а не передаём отсутствующие файлы в CSC.
       Временный проект WPF и IntelliSense не должны сбрасывать кэш основной сборки. -->
  <Target Name="InvalidateMissingMarkupOutputs"
          BeforeTargets="MarkupCompilePass1"
          Condition="'$(DesignTimeBuild)'!='true' and '$(AssemblyName)'=='XamlPreviewer'">
    <ItemGroup>
      <_ExpectedMarkupSource Include="@(Page->'$(IntermediateOutputPath)%(RelativeDir)%(Filename).g.cs')" />
      <_ExpectedMarkupSource Include="@(ApplicationDefinition->'$(IntermediateOutputPath)%(RelativeDir)%(Filename).g.cs')" />
      <_MissingMarkupSource Include="@(_ExpectedMarkupSource)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(IntermediateOutputPath)$(AssemblyName)_MarkupCompile.cache;$(IntermediateOutputPath)$(AssemblyName)_MarkupCompile.lref"
            Condition="'@(_MissingMarkupSource)'!=''" />
  </Target>

  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeBridgeOutputDir)XamlPreviewer.NativeBridge.dll')" Text="XamlPreviewer.NativeBridge.dll was not built: $(NativeBridgeOutputDir)XamlPreviewer.NativeBridge.dll" />
    <Copy SourceFiles="$(NativeBridgeOutputDir)XamlPreviewer.NativeBridge.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="$(NativeBridgeOutputDir)XamlPreviewer.NativeBridge.pdb" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(NativeBridgeOutputDir)XamlPreviewer.NativeBridge.pdb')" />
    <Copy SourceFiles="$(NativeBridgeOutputDir)libEGL.dll;$(NativeBridgeOutputDir)libGLESv2.dll;$(NativeBridgeOutputDir)$(NativeAngleZlibName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>