<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AndroidBuildTools</id>
        <version>1.0.40</version>
        <authors>DCT.C++Team</authors>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Shared PowerShell and CMake tools for native Android application builds.</description>
    </metadata>
    <files>
        <file src="tools\**\*" target="tools" />
        <file src="template_app\**\*" target="template_app" />
        <file src="gradle\**\*" target="gradle" exclude="gradle\build\**;gradle\.gradle\**" />
        <file src="README.md" target="" />
        <file src="BUILD-PIPELINE.md" target="" />
    </files>
</package>