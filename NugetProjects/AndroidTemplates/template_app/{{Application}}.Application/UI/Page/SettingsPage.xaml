<?xml version="1.0" encoding="utf-8"?>
<Page id="settingsPage"
      background="#1E1E1E"
      xmlns="urn:{{application}}:xaml"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid verticalAlignment="Stretch"
          horizontalAlignment="Stretch">
        <StackPanel width="320"
                    verticalAlignment="Center"
                    horizontalAlignment="Center"
                    orientation="Vertical">
            <TextBlock id="titleText"
                       margin="0 0 0 32"
                       horizontalAlignment="Center"
                       fontSize="48"
                       foreground="#FFFFFF"
                       text="Settings"/>
            <Button id="updateApplicationButton"
                    width="320"
                    height="72"
                    margin="0 0 0 16"
                    contentAlignment="Center"
                    horizontalAlignment="Center"
                    fontSize="36"
                    fontWeight="Bold"
                    foreground="#FFFFFF"
                    background="#3A6EA5"
                    command="{Binding UpdateApplicationCommand}"
                    text="Update application"/>
            <TextBlock id="updateStatusText"
                       width="320"
                       margin="0 0 0 16"
                       horizontalAlignment="Center"
                       fontSize="32"
                       foreground="#BDBDBD"
                       textWrapping="Wrap"
                       text="Update status: not checked"/>
            <Button id="backButton"
                    width="320"
                    height="72"
                    contentAlignment="Center"
                    horizontalAlignment="Center"
                    fontSize="36"
                    foreground="#FFFFFF"
                    background="#505050"
                    command="{Binding NavigateToMainCommand}"
                    text="Back"/>
        </StackPanel>
    </Grid>
</Page>