<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <ItemGroup Label="ProjectConfigurations">
        <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    </ItemGroup>
    <PropertyGroup Label="Globals">
        <ProjectGuid>{9B03EED5-FC73-481A-89E8-CB80DFD1B6B6}</ProjectGuid>
        <RootNamespace>XamlRuntime.Package</RootNamespace>
    </PropertyGroup>
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration"><ConfigurationType>Utility</ConfigurationType><PlatformToolset>v145</PlatformToolset></PropertyGroup>
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
    <ItemGroup>
        <None Include="Android\CMakeLists.txt" />
        <None Include="build\native\XamlRuntime.targets" />
        <None Include="cmake\XamlRuntimeConfig.cmake" />
        <None Include="Nuget.XamlRuntime.Pack.ps1" />
        <None Include="ThirdParty\ANGLE\vcpkg.json" />
        <None Include="XamlRuntime.nuspec" />
    </ItemGroup>
    <PropertyGroup>
        <PackageId>XamlRuntime</PackageId>
        <PackageVersion Condition="'$(PackageVersion)'==''">1.0.0</PackageVersion>
        <XamlRuntimePackageStagingDirectory>$(MSBuildProjectDirectory)\!NUGET_STAGING</XamlRuntimePackageStagingDirectory>
        <NuspecFile>$(XamlRuntimePackageStagingDirectory)\XamlRuntime.nuspec</NuspecFile>
        <NuspecBasePath>$(XamlRuntimePackageStagingDirectory)</NuspecBasePath>
        <PackageOutputPath Condition="'$(UH_NUGET_FEED)'!=''">$(UH_NUGET_FEED)</PackageOutputPath>
        <PackageOutputPath Condition="'$(PackageOutputPath)'==''">C:\NugetFeed</PackageOutputPath>
        <IsPackable>true</IsPackable>
        <PackageReferenceCompatibleProjectStyle>true</PackageReferenceCompatibleProjectStyle>
        <NoBuild>true</NoBuild>
    </PropertyGroup>
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
    <Import Project="XamlRuntime.Package.targets" />
    <Import Project="$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\NuGet\NuGet.Build.Tasks.Pack.targets" />

    <!-- This is a native Utility project, so NuGet restore reports its project
         style as Unknown and replaces the explicit true value above with false.
         The package is intentionally built from the prepared nuspec/staging tree,
         therefore retain the PackageReference-compatible Pack pipeline. -->
    <Target Name="_GetRestoreProjectStyle">
        <PropertyGroup>
            <PackageReferenceCompatibleProjectStyle>true</PackageReferenceCompatibleProjectStyle>
        </PropertyGroup>
    </Target>
</Project>