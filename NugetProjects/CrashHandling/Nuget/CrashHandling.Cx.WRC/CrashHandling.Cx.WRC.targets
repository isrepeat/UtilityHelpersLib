<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    NOTE: This project depends on CppFeatures.Desktop (set in .sln from VS IDE).
          So when you build this project CppFeatures.Desktop project was built first.
  -->
  <PropertyGroup>
    <ChannelLibrary>
			$(OutDir)\..\CrashHandling.Desktop\CrashHandling.Desktop.lib
		</ChannelLibrary>
  </PropertyGroup>
  
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>
        $(ChannelLibrary);
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <Lib>
      <AdditionalDependencies>
        $(ChannelLibrary);
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
</Project>