<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Target Name="ValidatePluginSdkPackageStaging" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(NuspecFile)')" Text="AndroidAppPreviewer.PluginSDK staging structure was not prepared: $(NuspecFile)" />
    </Target>
    <Target Name="CollectPluginSdkPackageFiles" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(PluginSdkPackageStagingDirectory)\**\*">
                <Pack>true</Pack>
                <PackagePath>%(RecursiveDir)</PackagePath>
            </None>
        </ItemGroup>
    </Target>
</Project>