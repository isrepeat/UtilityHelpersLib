<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreSources>
      https://api.nuget.org/v3/index.json;
      ../../Nuget/CppFeatures.WinRt.Projection/Nuget;
    </RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CppFeatures" Version="1.0.*" />
  </ItemGroup>

  <Target Name="EnsureNugetRestoreBeforeResolveRefs" DependsOnTargets="Restore" BeforeTargets="BeforeResolveReferences" />
</Project>